# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API.
# Leave empty to run with mock auth/data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (never prefix with VITE_): AI receipt scanning.
# Use an API key from Anthropic Console; Claude.ai account credentials are not API keys.
# In Vercel, add this as an Environment Variable and redeploy to apply changes.
ANTHROPIC_API_KEY=
